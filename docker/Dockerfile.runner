FROM python:3.12-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir pytest==8.3.3 \
    && useradd --uid 1000 --create-home --shell /usr/sbin/nologin runner

COPY entrypoint.sh /usr/local/bin/cf-entrypoint
RUN chmod 755 /usr/local/bin/cf-entrypoint

USER 1000:1000
WORKDIR /work
ENTRYPOINT ["/bin/sh", "/usr/local/bin/cf-entrypoint"]
