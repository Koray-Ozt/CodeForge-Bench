+"""Pricing constants. Business rule changes that are only numbers belong here.
+
+Amounts are integer cents; percentages are whole numbers.
+"""
+
+TAX = {"DE": 19, "AT": 20, "FR": 20, "GB": 20, "NL": 21, "US": 0, "NO": 25}
+EU = ("DE", "AT", "FR", "NL")
+ORIGIN = "DE"
+DOMESTIC = ("DE", "AT")  # no international shipping surcharge
+
+# (category, country) -> reduced VAT rate
+REDUCED_TAX = {("books", "DE"): 7}
+
+GIFT_CARD = "gift_card"  # never discounted, never taxed
+
+# Highest threshold first: (minimum quantity, percent off the line).
+VOLUME_TIERS = ((50, 10), (10, 5))
+TIER_PERCENT = {"gold": 5, "platinum": 8}
+
+SHIPPING_METHODS = ("standard", "express", "pickup")
+STANDARD_SHIPPING = 499
+FREE_SHIPPING_FROM = 5000
+EXPRESS_SHIPPING = 1299
+EXPRESS_EXTRA_PER_FIVE_ITEMS = 100
+INTERNATIONAL_SURCHARGE = 800
