+"""VAT rules."""
+
+from __future__ import annotations
+
+from collections.abc import Iterable, Mapping
+from typing import Any
+
+from .rates import EU, GIFT_CARD, ORIGIN, REDUCED_TAX, TAX
+
+
+def is_reverse_charge(customer: Mapping[str, Any], country: str) -> bool:
+    """B2B sales with a VAT id to another EU country are taxed by the buyer."""
+    business = bool(customer.get("is_business") and customer.get("vat_id"))
+    return business and country != ORIGIN and country in EU
+
+
+def tax_rate(category: str, country: str, reverse_charge: bool) -> int:
+    if reverse_charge:
+        return 0
+    return REDUCED_TAX.get((category, country), TAX[country])
+
+
+def apply_line_tax(
+    lines: Iterable[Any], discount_total: int, discountable: int, country: str, reverse: bool
+) -> int:
+    """Set `tax` on each taxable line and return their sum.
+
+    Order-level discounts are spread over lines pro rata, rounding each share on its own
+    (so the shares may not add up exactly; this matches historic invoices).
+    """
+    total = 0
+    for line in lines:
+        if line.category == GIFT_CARD:
+            continue
+        share = round(line.net * discount_total / discountable) if discountable else 0
+        rate = tax_rate(line.category, country, reverse)
+        line.tax = round((line.net - share) * rate / 100)
+        total += line.tax
+    return total
+
+
+def shipping_tax(shipping: int, country: str, reverse_charge: bool) -> int:
+    if not shipping or reverse_charge:
+        return 0
+    return round(shipping * TAX[country] / 100)
