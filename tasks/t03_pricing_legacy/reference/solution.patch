+"""Volume, tier and coupon discounts."""
+
+from __future__ import annotations
+
+from collections.abc import Callable
+from dataclasses import dataclass
+
+from .rates import GIFT_CARD, TIER_PERCENT, VOLUME_TIERS
+
+
+def _percent_of(amount: int, percent: int) -> int:
+    # round() is banker's rounding on a float; finance depends on the exact results.
+    return round(amount * percent / 100)
+
+
+def volume_discount(qty: int, gross: int, category: str | None) -> int:
+    if category == GIFT_CARD:
+        return 0
+    for minimum, percent in VOLUME_TIERS:
+        if qty >= minimum:
+            return _percent_of(gross, percent)
+    return 0
+
+
+def tier_discount(tier: str, discountable: int) -> int:
+    percent = TIER_PERCENT.get(tier)
+    return _percent_of(discountable, percent) if percent else 0
+
+
+@dataclass(frozen=True)
+class CouponContext:
+    tier: str
+    subtotal: int
+    discountable: int
+    tier_discount: int
+
+
+@dataclass(frozen=True)
+class CouponResult:
+    amount: int = 0
+    free_shipping: bool = False
+    label: str | None = None
+
+
+NO_COUPON = CouponResult()
+
+
+def _percent_coupon(code: str, percent: int, cap: int) -> Callable[[CouponContext], CouponResult]:
+    def apply(ctx: CouponContext) -> CouponResult:
+        if ctx.tier == "platinum":  # platinum members never stack percentage coupons
+            return NO_COUPON
+        base = ctx.discountable - ctx.tier_discount
+        amount = min(_percent_of(base, percent), cap)
+        return CouponResult(amount, label=f"coupon:{code}" if amount else None)
+
+    return apply
+
+
+def _fixed5(ctx: CouponContext) -> CouponResult:
+    if ctx.subtotal >= 2000:
+        return CouponResult(500, label="coupon:FIXED5")
+    return NO_COUPON
+
+
+def _free_shipping(ctx: CouponContext) -> CouponResult:
+    return CouponResult(free_shipping=True, label="coupon:FREESHIP")
+
+
+COUPONS: dict[str, Callable[[CouponContext], CouponResult]] = {
+    "SAVE10": _percent_coupon("SAVE10", 10, 5000),
+    "SAVE15": _percent_coupon("SAVE15", 15, 7500),
+    "FIXED5": _fixed5,
+    "FREESHIP": _free_shipping,
+}
+
+
+def apply_coupon(code: str | None, ctx: CouponContext) -> CouponResult:
+    handler = COUPONS.get(code.upper()) if code else None
+    return handler(ctx) if handler else NO_COUPON
