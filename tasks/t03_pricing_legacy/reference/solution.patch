@@ -0,0 +1,26 @@
+"""Shipping charges."""
+
+from .rates import (
+    DOMESTIC,
+    EXPRESS_EXTRA_PER_FIVE_ITEMS,
+    EXPRESS_SHIPPING,
+    FREE_SHIPPING_FROM,
+    INTERNATIONAL_SURCHARGE,
+    STANDARD_SHIPPING,
+)
+
+
+def _surcharge(country: str) -> int:
+    return 0 if country in DOMESTIC else INTERNATIONAL_SURCHARGE
+
+
+def shipping_cost(
+    method: str, country: str, items: int, after_discount: int, free_shipping: bool
+) -> int:
+    if method == "express":  # the FREESHIP coupon does not apply to express
+        extra = EXPRESS_EXTRA_PER_FIVE_ITEMS * ((items - 1) // 5)
+        return EXPRESS_SHIPPING + extra + _surcharge(country)
+    if method == "standard" and not free_shipping:
+        base = STANDARD_SHIPPING if after_discount < FREE_SHIPPING_FROM else 0
+        return base + _surcharge(country)
+    return 0
