diff --git a/hooks/signing.py b/hooks/signing.py
index 5895f53..d016938 100644
--- a/hooks/signing.py
+++ b/hooks/signing.py
@@ -11,8 +11,13 @@ DEFAULT_TOLERANCE_SECONDS = 300
 
 
 def sign(secret: str, body: bytes, timestamp: int) -> str:
-    """Return `v1=<hex>`, an HMAC-SHA256 of the request body."""
-    mac = hmac.new(secret.encode(), body, hashlib.sha256)
+    """Return `v1=<hex>`, an HMAC-SHA256 over `"<timestamp>." + body`.
+
+    The timestamp is part of the signed message so a captured request cannot be replayed
+    with a refreshed timestamp.
+    """
+    message = str(timestamp).encode() + b"." + body
+    mac = hmac.new(secret.encode(), message, hashlib.sha256)
     return "v1=" + mac.hexdigest()
 
 
@@ -26,5 +31,8 @@ def verify(
     tolerance: int = DEFAULT_TOLERANCE_SECONDS,
 ) -> bool:
     """Check a received signature. Rejects stale or far-future timestamps."""
+    if abs(now() - timestamp) > tolerance:
+        return False
     expected = sign(secret, body, timestamp)
-    return signature == expected
+    # Compare as bytes: compare_digest raises TypeError for non-ASCII str input.
+    return hmac.compare_digest(signature.encode(), expected.encode())
