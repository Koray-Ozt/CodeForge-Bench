 from __future__ import annotations
 
@@ -20,10 +23,36 @@ CREATE TABLE IF NOT EXISTS orders (
 CREATE INDEX IF NOT EXISTS idx_orders_customer ON orders (customer_id, id);
 """
 
+# Columns added after the first release: (name, DDL). Existing rows get the default.
+ADDED_COLUMNS = (
+    ("version", "INTEGER NOT NULL DEFAULT 1"),
+    ("idempotency_key", "TEXT"),
+    ("request_hash", "TEXT"),
+)
+
+# Partial unique index: only orders created with a key take part, so keyless orders are free.
+IDEMPOTENCY_INDEX = (
+    "CREATE INDEX IF NOT EXISTS idx_orders_idempotency"
+    " ON orders (customer_id, idempotency_key) WHERE idempotency_key IS NOT NULL"
+)
+
 
 def init_db(path: str) -> None:
     with connect(path) as conn:
         conn.executescript(SCHEMA)
+        # IMMEDIATE takes the write lock up front, so two workers starting together
+        # cannot both decide a column is missing.
+        conn.execute("BEGIN IMMEDIATE")
+        try:
+            existing = {row["name"] for row in conn.execute("PRAGMA table_info(orders)")}
+            for name, ddl in ADDED_COLUMNS:
+                if name not in existing:
+                    conn.execute(f"ALTER TABLE orders ADD COLUMN {name} {ddl}")
+            conn.execute(IDEMPOTENCY_INDEX)
+            conn.execute("COMMIT")
+        except BaseException:
+            conn.execute("ROLLBACK")
+            raise
 
 
